{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diuacm-api-prod",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-20",
  "compatibility_flags": ["nodejs_compat"],
  // Production traffic is served only through the managed Custom Domain.
  // Cloudflare creates the DNS record and edge certificate during deployment.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.diuacm.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  // Background solve/upsolve sync. One expression per platform so each can run
  // on its own cadence; src/sync/index.ts dispatches on the expression.
  "triggers": {
    "crons": [
      // Codeforces — one batch of handles per tick (see src/sync/codeforces.ts).
      // Must stay under an hour: Cloudflare gives sub-hourly crons 30s of CPU,
      // hourly and slower ones 15 min. This job needs seconds, not minutes.
      "*/15 * * * *",
      // AtCoder, offset to :05/:20/:35/:50 so the two never start together.
      "5,20,35,50 * * * *",
      // VJudge at :10/:25/:40/:55 — a batch of contests, not handles (see
      // src/sync/vjudge.ts), completing the 5-minute stagger.
      "10,25,40,55 * * * *",
      // Codeforces rating and handle refresh, 00:42 UTC (06:42 Dhaka). Daily
      // rather than sub-hourly because `user.info` takes every handle in one
      // call, so a whole run is a handful of requests — and because a slower
      // cron gets 15 min of CPU rather than 30s, which leaves room as the table
      // grows. See src/sync/cf-rating.ts.
      "42 0 * * *",
      // Daily health digest to the super admin, 01:12 UTC (07:12 Dhaka), half an
      // hour after the refresh so it can report what that raised. The odd
      // minutes are deliberate: :00/:15/:30/:45, :05/:20/:35/:50 and
      // :10/:25/:40/:55 all belong to a sync.
      "12 1 * * *"
    ]
  },
  // Alerts and the daily digest to SUPER_ADMIN_EMAIL (see src/lib/notify.ts).
  // Sends fail closed and are logged, never breaking a sync.
  //
  // `remote: true` only affects `wrangler dev`, where it proxies sends to the
  // real service. Without it a local send silently no-ops, which is the one
  // failure mode this whole feature exists to avoid — so local runs really do
  // mail the super admin. The 1h per-key cooldown keeps that bearable.
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diuacm-db-prod",
      "database_id": "d03da8ad-ceb9-48c8-9c64-66bd48d66c01",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "diuacm-files-prod"
    }
  ],
  // Per-IP throttle for the credential endpoints (/auth/login, /auth/google).
  // `namespace_id` is an arbitrary per-worker-unique integer string.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    // Browser origins allowed to call the API (comma-separated). Localhost is
    // always allowed in addition; an empty value allows every origin.
    "CORS_ORIGINS": "https://diuacm.com",
    // Google OAuth client id (public value — fine to commit). The ID token's
    // `aud` claim must match this. Replace with your own from the Google Cloud
    // console (OAuth 2.0 Client IDs).
    "GOOGLE_CLIENT_ID": "85673828423-q1upghugo5oehip02358e6tjvqi1pln2.apps.googleusercontent.com",
    // The super admin: implicitly holds every admin permission and is exempt
    // from the Google sign-in email-domain restriction. Compared case-insensitively.
    // Also the recipient of every sync alert and the daily digest.
    "SUPER_ADMIN_EMAIL": "sourovcodes@gmail.com",
    // Sender for those alerts. diuqbank.com is onboarded onto Email Sending in
    // this account (`wrangler email sending list`); the mailbox itself does not
    // need to exist, only the domain. Leave empty to disable sending entirely:
    // the faults are still recorded in `admin_notices` and logged.
    "ALERT_FROM_EMAIL": "alerts@diuqbank.com"
  }
}
