{
  "name": "diuacm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev:api": "pnpm --filter @diuacm/api dev",
    "dev:web": "pnpm --filter @diuacm/web dev",
    "build:web": "pnpm --filter @diuacm/web build",
    "typecheck": "pnpm --filter @diuacm/api typecheck && pnpm --filter @diuacm/web exec tsc -b",
    "lint": "pnpm --filter @diuacm/web lint",
    "test": "pnpm --filter @diuacm/api test && pnpm --filter @diuacm/web test",
    "deploy:api": "pnpm --filter @diuacm/api run deploy",
    "deploy:web": "pnpm --filter @diuacm/web run deploy"
  }
}
